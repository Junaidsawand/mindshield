# ==============================================================================
# MindShield Backend — Environment Variables Template
# Phase 2.1: FastAPI Foundation
#
# Copy this file to .env and populate with your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME="MindShield API"
APP_VERSION="2.1.0"
APP_ENV="development"            # development | staging | production
DEBUG=true

# --- Server ---
HOST="0.0.0.0"
PORT=8000

# --- API ---
API_V1_PREFIX="/api/v1"

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Logging ---
LOG_LEVEL="DEBUG"               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"               # json | text

# --- Security ---
# Secret key used for signing tokens in future phases
SECRET_KEY="CHANGE_ME_in_production_use_a_32_char_random_string"

# --- Model (Phase 2.2+ — placeholder for now) ---
MODEL_PATH=""
MODEL_VERSION="placeholder-v0"
MODEL_ENABLED=false
